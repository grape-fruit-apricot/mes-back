<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hansol.mes.inventory.model.dao.InventoryDao">
    <sql id="selectBase">SELECT i.item_id, i.item_code, i.item_name, i.unit, NVL(v.quantity, 0) AS quantity, v.updated_at FROM item i LEFT JOIN inventory v ON v.item_id = i.item_id</sql>
    <select id="search" resultType="com.hansol.mes.inventory.model.dto.InventoryResponse">
        <include refid="selectBase"/>
        <where>
            <include refid="com.hansol.mes.common.Query.itemFilters"/>
            
        </where>
        ORDER BY i.item_id DESC
        <include refid="com.hansol.mes.common.Query.page"/>
    </select>
    <select id="find" resultType="com.hansol.mes.inventory.model.dto.InventoryResponse">
        <include refid="selectBase"/> WHERE i.item_id = #{id}
    </select>
</mapper>

